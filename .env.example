# Copy this file to .env and fill in your own values. .env is gitignored,
# so your real credentials never get committed.
#
# Get these from your Kite Connect app: https://developers.kite.trade/apps

# Your Kite Connect app's API key.
KITE_API_KEY=

# Your Kite Connect app's API secret.
KITE_API_SECRET=

# Sandbox (signal_project paper trading) credentials. Unlike the two
# above, these are NOT personal secrets -- Kite's sandbox uses a shared
# public demo app (api_key "sandboxdemo", api_secret "sandboxdemo-secret",
# published in Zerodha's own docs as "safe to use in plain text, not tied
# to real money"). They're listed here only for consistency with how
# shared/data.py and signal_project/execution.py read credentials from the
# environment; if left unset, signal_project/execution.py falls back to
# these same published defaults.
KITE_SANDBOX_API_KEY=
KITE_SANDBOX_API_SECRET=

# Interactive Brokers (data_providers/ibkr_connection.py). All optional, and
# NOT credentials: TWS handles the login, so nothing secret goes here. Leave
# a line commented out (or empty) to use the default shown. Paper and live
# are chosen per run (e.g. run_report --source ibkr_paper / ibkr_live); there
# is no fallback from one to the other.
# IBKR_HOST=127.0.0.1
# IBKR_PAPER_PORT=7497
# IBKR_LIVE_PORT=7496
# Client ID defaults to 17 for paper and 18 for live.
# IBKR_CLIENT_ID=
# Connection timeout in seconds.
# IBKR_TIMEOUT=10
